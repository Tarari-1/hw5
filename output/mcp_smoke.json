  "tests": [
    {
      "ticket": 101,
      "prompt": "Do we have any Classic Bulldog Tees in white, size S, in stock? What about other sizes?",
      "tool": "mcp__campus-customs__check_stock",
      "arguments": {
        "sku": "CC-TEE-WHITE",
        "size": "S"
      },
      "tool_output": {
        "found": true,
        "sku": "CC-TEE-WHITE",
        "size": "S",
        "name": "Classic Bulldog Tee",
        "qty": 0,
        "location": "Aisle B",
        "all_sizes": [
          {
            "size": "L",
            "qty": 3,
            "location": "Aisle B"
          },
          {
            "size": "M",
            "qty": 5,
            "location": "Aisle B"
          },
          {
            "size": "S",
            "qty": 0,
            "location": "Aisle B"
          },
          {
            "size": "XL",
            "qty": 2,
            "location": "Aisle B"
          }
        ]
      },
      "database_check": [
        {
          "query": "SELECT sku, size, name, qty, location FROM inventory WHERE sku = ? AND size = ?",
          "params": [
            "CC-TEE-WHITE",
            "S"
          ],
          "rows": [
            {
              "sku": "CC-TEE-WHITE",
              "size": "S",
              "name": "Classic Bulldog Tee",
              "qty": 0,
              "location": "Aisle B"
            }
          ]
        },
        {
          "query": "SELECT size, qty, location FROM inventory WHERE sku = ? ORDER BY size",
          "params": [
            "CC-TEE-WHITE"
          ],
          "rows": [
            {
              "size": "L",
              "qty": 3,
              "location": "Aisle B"
            },
            {
              "size": "M",
              "qty": 5,
              "location": "Aisle B"
            },
            {
              "size": "S",
              "qty": 0,
              "location": "Aisle B"
            },
            {
              "size": "XL",
              "qty": 2,
              "location": "Aisle B"
            }
          ]
        }
      ],
      "matches_database": true
    },
